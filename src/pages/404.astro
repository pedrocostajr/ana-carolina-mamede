---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { SITE_INFO } from '../lib/constants';
---
<BaseLayout
  title="Página Não Encontrada (404) | Dra. Ana Carolina Mamede"
  description="A página que você está procurando não existe ou foi alterada. Conheça nossos atendimentos em endocrinologia."
  noindex={true}
  waOrigin="404"
>
  <section class="section sand" style="min-height: 70vh; display: flex; align-items: center; text-align: center;">
    <div class="wrap" style="max-width: 680px; margin: 0 auto;">
      <span class="eyebrow" style="color: var(--terra);">Erro 404</span>
      <h1 style="margin: 16px 0 18px; font-size: clamp(34px, 5vw, 48px);">
        Página não encontrada
      </h1>
      <p class="lead" style="margin-bottom: 32px;">
        O endereço que você tentou acessar não existe, foi modificado ou está temporariamente indisponível.
      </p>

      <div style="background: #fff; padding: 28px; border-radius: var(--radius); border: 1px solid var(--sand-3); margin-bottom: 32px; text-align: left;">
        <b style="color: var(--brown); font-size: 16.5px; display: block; margin-bottom: 12px;">
          Você pode encontrar o que procura por aqui:
        </b>
        <ul style="list-style: none; display: grid; gap: 10px; font-size: 15px;">
          <li><a href="/" style="color: var(--brown-2); font-weight: 500;">→ Página Inicial</a></li>
          <li><a href="/areas" style="color: var(--brown-2); font-weight: 500;">→ Áreas de Atuação (Obesidade, Diabetes, Tireoide, Menopausa, Colesterol)</a></li>
          <li><a href="/consulta-online" style="color: var(--brown-2); font-weight: 500;">→ Consulta Online para Todo o Brasil</a></li>
          <li><a href="/blog" style="color: var(--brown-2); font-weight: 500;">→ Artigos do Blog</a></li>
          <li><a href="/material-gratuito" style="color: var(--brown-2); font-weight: 500;">→ Guia Gratuito de Metabolismo</a></li>
        </ul>
      </div>

      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a class="btn" href="/">Voltar para o início</a>
        <BotaoWhatsApp originKey="404" text="Falar no WhatsApp" className="btn ghost" />
      </div>
    </div>
  </section>
</BaseLayout>
